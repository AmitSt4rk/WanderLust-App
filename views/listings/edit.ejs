<% layout("/layouts/boilerplate") %>

    <body>
        <div class="en-listing-form-border">
            <div class="en-listing-form-container">
                <form action="/listings/<%= listing._id %>?_method=PUT" method="post" class="needs-validation" enctype="multipart/form-data"
                    novalidate>
                    <div class="mb-2">
                        <label for="title" class="form-label">Title</label>
                        <input id="title" class="form-control" type="text" name="title" value="<%= listing.title %>"
                            placeholder="Enter title.." required>
                        <div class="invalid-feedback">
                            why are you not entering a title here.
                        </div>
                    </div>
                    <div class="mb-2">
                        <label for="description" class="form-label">Description</label>
                        <textarea id="description" class="form-control" name="description" cols="30" rows="10"
                            placeholder="Enter description here.." required><%=listing.description%></textarea>
                        <div class="invalid-feedback">
                            you to write something about this.
                        </div>
                    </div>
                    <div class="mb-2">
                        <label for="img" class="form-label">upload new Image ( Optional )</label>
                        <input id="img" class="form-control" type="file" name="image">
                    </div>
                    <div class="row">
                        <div class="mb-2 col-md-4">
                            <label for="price" class="form-label">Price</label>
                            <input id="price" class="form-control" type="number" name="price"
                                value="<%= listing.price %>" placeholder="Enter price.." required>
                            <div class="invalid-feedback">
                                Please enter a valid price here
                            </div>
                        </div>
                        <div class="mb-2 col-md-8">
                            <label for="country" class="form-label">Country</label>
                            <input id="country" class="form-control" type="text" name="country"
                                value="<%= listing.country %>" placeholder="Enter your country.." required>
                            <div class="invalid-feedback">
                                you don't have country!
                            </div>
                        </div>
                    </div>
                    <div class="mb-2">
                        <label for="location" class="form-label">Location</label>
                        <input id="location" class="form-control" type="text" name="location"
                            value="<%= listing.location %>" placeholder="Enter Location.." required>
                        <div class="invalid-feedback">
                            need location of yours.
                        </div>
                    </div>
                    <button class="btn btn-outline-success">Edit</button>
                </form>
            </div>
        </div>
    </body>